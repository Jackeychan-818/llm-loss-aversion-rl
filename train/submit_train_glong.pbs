#!/bin/bash
# ============================================================
# PBS Job Script — Extended GRPO training on remaining_goods.json
# Use this when a full epoch cannot fit inside the 24h g1 limit.
# ============================================================
#PBS -N lz-grpo-long
#PBS -q glong
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=72:00:00
#PBS -o /home/users/jackeyc0/scratch/lambda-zero/logs/train_long_${PBS_JOBID}.out
#PBS -e /home/users/jackeyc0/scratch/lambda-zero/logs/train_long_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

# ---------- Environment ----------
cd $PBS_O_WORKDIR
module purge
module load pytorch/2.10.0-py3-cu12.6

PROJECT_DIR="$HOME/scratch/lambda-zero"
source "$PROJECT_DIR/venv/bin/activate"

# ---------- Verify GPU ----------
echo "=== GPU Check ==="
nvidia-smi
python -c "import torch; print(f'CUDA devices: {torch.cuda.device_count()}, Device: {torch.cuda.get_device_name(0)}')"
python -c "import trl; print(f'TRL version: {trl.__version__}')"

# ---------- Run extended training ----------
echo "=== Starting extended GRPO training ==="
echo "Start time: $(date)"
cd "$PROJECT_DIR"

OUTPUT_DIR="${OUTPUT_DIR:-checkpoints/grpo_current}"
RESUME_FROM_CHECKPOINT="${RESUME_FROM_CHECKPOINT:-auto}"
mkdir -p "$OUTPUT_DIR"

echo "Output dir: $OUTPUT_DIR"
echo "Resume from checkpoint: $RESUME_FROM_CHECKPOINT"

python train/grpo_train.py \
    --config train/configs/qwen25_7b.yaml \
    --mode train \
    --data_file data/remaining_goods.json \
    --output_dir "$OUTPUT_DIR" \
    --save_steps 200 \
    --eval_steps 200 \
    --eval_data_file data/trial_goods.json \
    --resume_from_checkpoint "$RESUME_FROM_CHECKPOINT" \
    2>&1 | tee logs/train_long_run.log

echo "=== Extended training complete ==="
echo "End time: $(date)"
