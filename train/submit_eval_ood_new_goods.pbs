#!/bin/bash
# ============================================================
# PBS Job — frozen 50-good OOD evaluation
#
# Evaluates the same never-train/never-select suite on:
#   1. Base Qwen2.5-7B-Instruct
#   2. Consensus-reward GRPO final adapter
#   3. Selected Qwen-delta adapter (step 8,000)
#
# Override adapter paths at submission time if needed:
#   qsub -v CONSENSUS_ADAPTER=/path/to/adapter,QWEN_DELTA_ADAPTER=/path/to/adapter \
#     train/submit_eval_ood_new_goods.pbs
# ============================================================
#PBS -N lz-eval-ood50
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=12:00:00
#PBS -o /home/users/nus/jackeyc0/scratch/lambda-zero/logs/eval_ood50_${PBS_JOBID}.out
#PBS -e /home/users/nus/jackeyc0/scratch/lambda-zero/logs/eval_ood50_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-$HOME/scratch/lambda-zero}"
BASE_MODEL="${BASE_MODEL:-models/Qwen2.5-7B-Instruct}"
CONSENSUS_ADAPTER="${CONSENSUS_ADAPTER:-checkpoints/grpo_20260427_1724/final}"
QWEN_DELTA_ADAPTER="${QWEN_DELTA_ADAPTER:-checkpoints/grpo_qwen_delta/final}"
OOD_GOODS="data/ood_new_goods_50.json"
OOD_CASES="data/ood_new_goods_50_test.json"
OUTPUT_ROOT="ood"
BATCH_SIZE="${BATCH_SIZE:-8}"

cd "$PROJECT_DIR"
mkdir -p logs "$OUTPUT_ROOT"

module purge
module load pytorch/2.6.0-py3-cu11.8
source "$PROJECT_DIR/venv/bin/activate"
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib 2>/dev/null):${LD_LIBRARY_PATH:-}"

if [[ ! -d "$BASE_MODEL" ]]; then
    echo "ERROR: base model directory not found: $BASE_MODEL" >&2
    exit 1
fi
if [[ ! -f "$OOD_GOODS" || ! -f "$OOD_CASES" ]]; then
    echo "ERROR: OOD suite is missing. Pull the latest repository changes first." >&2
    exit 1
fi
if [[ ! -d "$CONSENSUS_ADAPTER" ]]; then
    echo "ERROR: consensus adapter not found: $CONSENSUS_ADAPTER" >&2
    exit 1
fi
if [[ ! -d "$QWEN_DELTA_ADAPTER" && -d checkpoints/grpo_qwen_delta/checkpoint-8000 ]]; then
    echo "Qwen-delta final adapter not found; using frozen checkpoint-8000 directly."
    QWEN_DELTA_ADAPTER="checkpoints/grpo_qwen_delta/checkpoint-8000"
fi
if [[ ! -d "$QWEN_DELTA_ADAPTER" ]]; then
    echo "ERROR: Qwen-delta adapter not found: $QWEN_DELTA_ADAPTER" >&2
    echo "Set QWEN_DELTA_ADAPTER or preserve checkpoint-8000 at the standard path." >&2
    exit 1
fi

echo "=== OOD-50 evaluation ==="
echo "Project:           $PROJECT_DIR"
echo "Base model:        $BASE_MODEL"
echo "Consensus adapter: $CONSENSUS_ADAPTER"
echo "Qwen-delta adapter:$QWEN_DELTA_ADAPTER"
echo "Cases:             $OOD_CASES"
echo "Goods:             $OOD_GOODS"
nvidia-smi
python -c "import torch; print(f'CUDA device: {torch.cuda.get_device_name(0)}')"

run_eval() {
    local model_name="$1"
    local adapter_path="${2:-}"
    local log_stem="$3"

    echo "=== Evaluating $model_name ==="
    local adapter_args=()
    if [[ -n "$adapter_path" ]]; then
        adapter_args=(--adapter_path "$adapter_path")
    fi

    python eval/run_qwen_local.py \
        --model_path "$BASE_MODEL" \
        "${adapter_args[@]}" \
        --model_name "$model_name" \
        --data_file "$OOD_CASES" \
        --goods_json "$OOD_GOODS" \
        --treatment baseline \
        --output_root "$OUTPUT_ROOT" \
        --batch_size "$BATCH_SIZE" \
        --yes \
        2>&1 | tee "logs/${log_stem}_eval.log"

    echo "=== Estimating $model_name ==="
    python eval/estimate_qwen_checkpoint.py \
        --model_name "$model_name" \
        --feature "$OUTPUT_ROOT" \
        --robust_model 1 \
        --link-scale 1 \
        2>&1 | tee "logs/${log_stem}_estimate.log"
}

run_eval "Qwen-7B-Base-OOD50" "" "ood50_base"
run_eval "Qwen-7B-GRPO-Consensus-OOD50" "$CONSENSUS_ADAPTER" "ood50_consensus"
run_eval "Qwen-7B-GRPO-QwenDelta-step8000-OOD50" "$QWEN_DELTA_ADAPTER" "ood50_qwen_delta"

echo "=== OOD-50 evaluation complete ==="
echo "Results are under: $PROJECT_DIR/$OUTPUT_ROOT/"
