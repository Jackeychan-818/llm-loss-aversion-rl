#!/bin/bash
# ============================================================
# PBS Job — MATCHED local-base evaluation (PAPER_READINESS.md Priority-0 #1)
#
# Why: lambda_before = 11.75 is NOT a matched baseline. It used Together's
# Qwen/Qwen2.5-7B-Instruct-Turbo, 9,950 cases, and top-five FIRST-TOKEN
# probabilities. Every post-training number uses the LOCAL
# models/Qwen2.5-7B-Instruct, 9,890 test_goods rows, and exact normalized
# teacher-forced Yes/No SEQUENCE scores. So "11.75 -> 0.111" currently confounds
# training with endpoint + sample + scorer changes.
#
# This job evaluates the EXACT local base checkpoint with NO adapter, on the same
# 9,890 test_goods.json rows, with the same evaluator and the same structural
# code used for the adapters — giving a strictly matched lambda_before.
#
# Writes to baseline/Qwen-7B-Base-Local/ (does NOT touch the historical
# baseline/Qwen-7B/, which holds the 9,950-case Together run).
#
#   qsub train/submit_eval_base_matched.pbs
#   qsub -v LIMIT=20 train/submit_eval_base_matched.pbs      # smoke test first
# ============================================================
#PBS -N lz-base-matched
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=04:00:00
#PBS -o /home/users/nus/jackeyc0/scratch/lambda-zero/logs/base_matched_${PBS_JOBID}.out
#PBS -e /home/users/nus/jackeyc0/scratch/lambda-zero/logs/base_matched_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

PROJECT_DIR="$HOME/scratch/lambda-zero"
cd "$PROJECT_DIR"
module purge
module load pytorch/2.6.0-py3-cu11.8
source "$PROJECT_DIR/venv/bin/activate"
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib 2>/dev/null):$LD_LIBRARY_PATH"

MODEL_NAME="${MODEL_NAME:-Qwen-7B-Base-Local}"
LIMIT="${LIMIT:-}"
LIMIT_ARGS=()
[[ -n "$LIMIT" ]] && LIMIT_ARGS+=(--limit "$LIMIT")

echo "=== GPU Check ==="; nvidia-smi
echo "Matched base eval -> baseline/${MODEL_NAME}  (NO adapter, local base weights)"
if [[ ! -f models/Qwen2.5-7B-Instruct/config.json ]]; then
    echo "ERROR: local base model not found at models/Qwen2.5-7B-Instruct"; exit 1
fi

# ---------- Eval: EXACT local base, NO adapter, same rows + same scorer ----------
python eval/run_qwen_local.py \
    --model_path models/Qwen2.5-7B-Instruct \
    --model_name "$MODEL_NAME" \
    --data_file data/test_goods.json \
    --treatment baseline \
    --batch_size 8 \
    "${LIMIT_ARGS[@]}" \
    --yes \
    2>&1 | tee "logs/eval_${MODEL_NAME}.log"

# ---------- Same structural code as the adapters: Model A NLS, link scale T=1 ----------
if [[ -z "$LIMIT" ]]; then
    python eval/estimate_qwen_checkpoint.py \
        --feature baseline \
        --model_name "$MODEL_NAME" \
        --link-scale 1 \
        2>&1 | tee "logs/estimate_${MODEL_NAME}.log"
else
    echo "LIMIT set ($LIMIT) — skipping NLS (structural estimation needs the full set)."
fi

echo "=== Done: matched base -> baseline/${MODEL_NAME} ==="
