#!/bin/bash
# ============================================================
# PBS — Evaluate the FROZEN prospective unused-configuration test
# (data/frozen_unused_test_goods.json: 49,450 cases, 98,900 X/Y prompts/model).
#
# FREEZE POLICY (data/FROZEN_UNUSED_TEST.md): this set may be opened ONLY for the
# matched local base and the two already-selected confirmatory checkpoints
# (seed 1 @ 2,000, seed 2 @ 6,000). It must NEVER inform training, reward
# construction, checkpoint selection, or method changes. This script therefore
# hard-refuses any TARGET other than base / seed1 / seed2.
#
# Run once per allowed target:
#   qsub -v TARGET=base  train/submit_eval_frozen_unused.pbs
#   qsub -v TARGET=seed1 train/submit_eval_frozen_unused.pbs
#   qsub -v TARGET=seed2 train/submit_eval_frozen_unused.pbs
# ============================================================
#PBS -N lz-frozenUC
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=10:00:00
#PBS -o /home/users/nus/jackeyc0/scratch/lambda-zero/logs/frozenUC_${PBS_JOBID}.out
#PBS -e /home/users/nus/jackeyc0/scratch/lambda-zero/logs/frozenUC_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

PROJECT_DIR="$HOME/scratch/lambda-zero"
set -euo pipefail
cd "$PROJECT_DIR"
set +u
module purge
module load pytorch/2.6.0-py3-cu11.8
source "$PROJECT_DIR/venv/bin/activate"
set -u
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib 2>/dev/null || true):${LD_LIBRARY_PATH:-}"

: "${TARGET:?Must pass -v TARGET=base|seed1|seed2}"
FEATURE="frozen_unused"
DATA="data/frozen_unused_test_goods.json"
ADAPTER=""
case "$TARGET" in
  base)  MODEL_NAME="Qwen-7B-Base-Local-frozenUC" ;;
  seed1) ADAPTER="checkpoints/grpo_qwen_delta_seed1/checkpoint-2000"
         MODEL_NAME="Qwen-7B-GRPO-qd-seed1-ckpt2000-frozenUC" ;;
  seed2) ADAPTER="checkpoints/grpo_qwen_delta_seed2/checkpoint-6000"
         MODEL_NAME="Qwen-7B-GRPO-qd-seed2-ckpt6000-frozenUC" ;;
  *) echo "REFUSED: TARGET='$TARGET' violates the freeze policy. Only base|seed1|seed2 "
     echo "may open the frozen unused-configuration test (data/FROZEN_UNUSED_TEST.md)."; exit 2 ;;
esac

echo "=== Frozen unused-config eval: TARGET=$TARGET -> $FEATURE/$MODEL_NAME ==="
nvidia-smi
if [[ -n "$ADAPTER" && ! -d "$ADAPTER" ]]; then
    echo "ERROR: adapter dir not found: $ADAPTER"; exit 1
fi

# ---------- Eval: teacher-forced log-probs on the frozen test ----------
ADAPTER_ARGS=()
[[ -n "$ADAPTER" ]] && ADAPTER_ARGS=(--adapter_path "$ADAPTER")
python eval/run_qwen_local.py \
    --model_path models/Qwen2.5-7B-Instruct \
    "${ADAPTER_ARGS[@]}" \
    --model_name "$MODEL_NAME" \
    --data_file "$DATA" \
    --treatment baseline \
    --output_root "$FEATURE" \
    --batch_size 8 \
    --yes \
    2>&1 | tee "logs/eval_${MODEL_NAME}.log"

# ---------- Model A NLS estimation (T=1) ----------
python eval/estimate_qwen_checkpoint.py \
    --model_name "$MODEL_NAME" \
    --feature "$FEATURE" \
    --link-scale 1 \
    2>&1 | tee "logs/estimate_${MODEL_NAME}.log"

echo "=== Done: $FEATURE/$MODEL_NAME (frozen unused-config, evaluate exactly once) ==="
