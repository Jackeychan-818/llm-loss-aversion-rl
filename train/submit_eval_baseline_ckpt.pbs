#!/bin/bash
# ============================================================
# PBS — Evaluate ONE causal-baseline checkpoint on test_goods (VALIDATION ONLY)
#
# For the matched-SFT and sign-only-GRPO baselines. Writes to a SEPARATE output
# root `baselines/` (NOT `baseline/`) with names that cannot match the
# confirmatory selector globs (Qwen-7B-GRPO-qd[-seedN]-ckpt*), so baseline evals
# can never collide with or be swept into the frozen confirmatory selection.
#
# test_goods is VALIDATION only. This script HARD-REFUSES OOD-50 and the frozen
# unused-configuration set — those must not be reopened for baseline tuning.
#
# Submit (one per checkpoint):
#   qsub -v METHOD=sft,SEED=1,CKPT=2000  train/submit_eval_baseline_ckpt.pbs
#   qsub -v METHOD=sign,SEED=1,CKPT=6000 train/submit_eval_baseline_ckpt.pbs
# ============================================================
#PBS -N lz-eval-baseline
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=02:00:00
# Leave PBS stdout/stderr at its default job-specific path. PBS does not expand
# ${PBS_JOBID} in #PBS directives, so explicit paths here would make concurrent
# submissions overwrite one literal shared filename. The commands below also
# tee stable, per-model logs under logs/.
#PBS -j oe
#PBS -P personal-jackeyc0

set -euo pipefail

cd "$PBS_O_WORKDIR"
PROJECT_DIR="$HOME/scratch/lambda-zero"
set +u
module purge
module load pytorch/2.6.0-py3-cu11.8
source "$PROJECT_DIR/venv/bin/activate"
set -u
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib 2>/dev/null || true):${LD_LIBRARY_PATH:-}"

cd "$PROJECT_DIR"
: "${METHOD:?Must pass -v METHOD=sft|sign}"
: "${SEED:?Must pass -v SEED=<n>}"
: "${CKPT:?Must pass -v CKPT=<step>}"

FEATURE="baselines"                 # deliberately NOT `baseline` — no selector overlap
DATA="data/test_goods.json"         # VALIDATION only; not overridable here
case "$METHOD" in
  sft)  ADAPTER="checkpoints/sft_qwen_delta_seed${SEED}/checkpoint-${CKPT}"
        MODEL_NAME="Qwen-7B-SFT-qd-seed${SEED}-ckpt${CKPT}" ;;
  sign) ADAPTER="checkpoints/grpo_qwen_delta_sign_seed${SEED}/checkpoint-${CKPT}"
        MODEL_NAME="Qwen-7B-GRPO-sign-seed${SEED}-ckpt${CKPT}" ;;
  *) echo "REFUSED: METHOD='$METHOD' must be sft or sign."; exit 2 ;;
esac
# Defence in depth: never let this script touch OOD / frozen-unused data.
# (match the actual dataset names, not any 'ood' substring — 'test_goods'
#  contains 'ood'.)
case "$DATA" in
  *ood_new_goods*|*frozen_unused*) echo "REFUSED: baseline eval must use test_goods only."; exit 2 ;;
esac

echo "=== Baseline eval: METHOD=$METHOD SEED=$SEED CKPT=$CKPT ==="
nvidia-smi
echo "adapter=$ADAPTER  ->  $FEATURE/$MODEL_NAME  (data=$DATA, VALIDATION)"
if [[ ! -d "$ADAPTER" ]]; then echo "ERROR: adapter not found: $ADAPTER"; exit 1; fi

python eval/run_qwen_local.py \
    --model_path models/Qwen2.5-7B-Instruct \
    --adapter_path "$ADAPTER" \
    --model_name "$MODEL_NAME" \
    --data_file "$DATA" \
    --treatment baseline \
    --output_root "$FEATURE" \
    --batch_size 8 \
    --yes \
    2>&1 | tee "logs/eval_${MODEL_NAME}.log"

python eval/estimate_qwen_checkpoint.py \
    --model_name "$MODEL_NAME" \
    --feature "$FEATURE" \
    --link-scale 1 \
    2>&1 | tee "logs/estimate_${MODEL_NAME}.log"

echo "=== Done: $FEATURE/$MODEL_NAME (test_goods validation) ==="
