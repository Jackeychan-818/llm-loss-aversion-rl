#!/bin/bash
# ============================================================
# PBS Job — v2-core GRPO SANITY (R_pair + R_neutral)
# 20 optimizer steps on remaining_goods.json (which has frozen anchors).
# Throwaway checkpoint. Purpose: confirm the paired trainer runs and that logs
# report reward=v2_core, R_pair, R_neutral, anchor coverage, zero-std, KL, Yes/No.
#
#   qsub train/submit_sanity_v2core.pbs
# ============================================================
#PBS -N lz-v2-sanity
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=02:00:00
#PBS -o /home/users/nus/jackeyc0/scratch/lambda-zero/logs/v2_sanity_${PBS_JOBID}.out
#PBS -e /home/users/nus/jackeyc0/scratch/lambda-zero/logs/v2_sanity_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

PROJECT_DIR="$HOME/scratch/lambda-zero"
cd "$PROJECT_DIR"
module purge
module load pytorch/2.6.0-py3-cu11.8
source "$PROJECT_DIR/venv/bin/activate"
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib 2>/dev/null):${LD_LIBRARY_PATH:-}"

echo "=== GPU Check ==="
nvidia-smi
python -c "import torch; print(f'CUDA: {torch.cuda.get_device_name(0)}')"

# ---------- Pure-logic tests first (fail fast) ----------
echo "=== v2 unit tests ==="
( cd train && python test_paired_grpo.py ) || { echo "UNIT TESTS FAILED"; exit 1; }
python train/reward_functions_v2.py || { echo "REWARD LOGIC TESTS FAILED"; exit 1; }

# ---------- Sanity training ----------
echo "=== v2-core sanity training (20 steps) ==="
python train/grpo_train_v2.py \
    --config train/configs/qwen25_7b_v2core.yaml \
    --mode sanity --max_steps 20 \
    --data_file data/remaining_goods.json \
    --output_dir checkpoints/sanity_v2core \
    2>&1 | tee logs/sanity_v2core.log

echo "=== v2-core sanity complete ==="
