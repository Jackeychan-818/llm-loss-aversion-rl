#!/bin/bash
# ============================================================
# PBS Job Script — GRPO Reward Design v2 CORE (R_pair + R_neutral)
# Full run. Uses train/grpo_train_v2.py (PairedGRPOTrainer) with
# qwen25_7b_v2core.yaml. NOT the legacy consensus-delta job — this is the
# ownership-consistency + frozen-neutral-anchor reward.
#
#   qsub train/submit_train_v2core.pbs
#   qsub -v OUTPUT_DIR=checkpoints/grpo_v2core,RESUME_FROM_CHECKPOINT=auto \
#        train/submit_train_v2core.pbs
# ============================================================
#PBS -N lz-grpo-v2
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=72:00:00
#PBS -o /home/users/nus/jackeyc0/scratch/lambda-zero/logs/train_v2core_${PBS_JOBID}.out
#PBS -e /home/users/nus/jackeyc0/scratch/lambda-zero/logs/train_v2core_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

# ---------- Environment ----------
cd $PBS_O_WORKDIR
module purge
module load pytorch/2.6.0-py3-cu11.8

PROJECT_DIR="$HOME/scratch/lambda-zero"
source "$PROJECT_DIR/venv/bin/activate"

export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib):$LD_LIBRARY_PATH"

# ---------- Verify GPU ----------
echo "=== GPU Check ==="
nvidia-smi
python -c "import torch; print(f'CUDA devices: {torch.cuda.device_count()}, Device: {torch.cuda.get_device_name(0)}')"

# ---------- Pin check: TRL version (fail fast) ----------
python -c "import trl,sys; want='1.3.0'; got=trl.__version__; print(f'TRL {got} (pinned {want})'); sys.exit(0 if got==want else 1)" \
    || { echo "TRL VERSION MISMATCH — expected 1.3.0"; exit 1; }

# ---------- Unit tests (fail fast, same as sanity) ----------
( cd train && python test_paired_grpo.py ) || { echo "UNIT TESTS FAILED"; exit 1; }
python train/reward_functions_v2.py || { echo "REWARD LOGIC TESTS FAILED"; exit 1; }

# ---------- Run training ----------
echo "=== Starting GRPO v2-core (R_pair + R_neutral) ==="
echo "Start time: $(date)"
cd "$PROJECT_DIR"

OUTPUT_DIR="${OUTPUT_DIR:-checkpoints/grpo_v2core}"
RESUME_FROM_CHECKPOINT="${RESUME_FROM_CHECKPOINT:-auto}"
mkdir -p "$OUTPUT_DIR"

echo "Output dir: $OUTPUT_DIR"
echo "Resume from checkpoint: $RESUME_FROM_CHECKPOINT"

python train/grpo_train_v2.py \
    --config train/configs/qwen25_7b_v2core.yaml \
    --mode train \
    --data_file data/remaining_goods.json \
    --output_dir "$OUTPUT_DIR" \
    --save_steps 200 \
    --resume_from_checkpoint "$RESUME_FROM_CHECKPOINT" \
    2>&1 | tee -a logs/train_v2core_run.log

echo "=== v2-core training complete ==="
echo "End time: $(date)"
