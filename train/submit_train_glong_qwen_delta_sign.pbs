#!/bin/bash
# ============================================================
# PBS — SIGN-ONLY GRPO baseline (Priority 1B, CAUSAL_BASELINE_PROTOCOL.md)
#
# IDENTICAL to submit_train_glong_qwen_delta.pbs except it uses the sign-only
# config (reward ±1 instead of ±|delta|) and a SEPARATE output directory so it
# can never overwrite the confirmatory magnitude runs.
#
# Submit (do NOT run automatically):
#   qsub -v SEED=1 train/submit_train_glong_qwen_delta_sign.pbs
#   qsub -v SEED=2 train/submit_train_glong_qwen_delta_sign.pbs
#   # pilot (1 seed, short): qsub -v SEED=1,MAX_STEPS=6000 ...
# ============================================================
#PBS -N lz-grpo-qd-sign
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=72:00:00
#PBS -o /home/users/nus/jackeyc0/scratch/lambda-zero/logs/train_qd_sign_${PBS_JOBID}.out
#PBS -e /home/users/nus/jackeyc0/scratch/lambda-zero/logs/train_qd_sign_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

set -euo pipefail

cd "$PBS_O_WORKDIR"
PROJECT_DIR="$HOME/scratch/lambda-zero"
# module system + venv reference unbound vars internally; guard nounset around them
set +u
module purge
module load pytorch/2.6.0-py3-cu11.8
source "$PROJECT_DIR/venv/bin/activate"
set -u
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib 2>/dev/null || true):${LD_LIBRARY_PATH:-}"

echo "=== GPU Check ==="
nvidia-smi
python -c "import torch, trl; print(f'CUDA {torch.cuda.get_device_name(0)}, TRL {trl.__version__}')"

cd "$PROJECT_DIR"
SEED="${SEED:-1}"
MAX_STEPS="${MAX_STEPS:-30000}"   # frozen endpoint (matches confirmatory GRPO)
# Dedicated per-seed output dir — NEVER the confirmatory magnitude dirs.
OUTPUT_DIR="${OUTPUT_DIR:-checkpoints/grpo_qwen_delta_sign_seed${SEED}}"
RESUME_FROM_CHECKPOINT="${RESUME_FROM_CHECKPOINT:-auto}"
# Guard 1: refuse to write into a magnitude/confirmatory directory.
case "$OUTPUT_DIR" in
  checkpoints/grpo_qwen_delta|checkpoints/grpo_qwen_delta_seed*)
    echo "REFUSED: OUTPUT_DIR '$OUTPUT_DIR' is a confirmatory magnitude run dir."; exit 2 ;;
esac
# Guard 2: OUTPUT_DIR must encode this seed, so seed N can never write to / resume
# from seed M's directory (auto-resume only ever looks inside OUTPUT_DIR).
[[ "$OUTPUT_DIR" == *"seed${SEED}"* ]] || {
    echo "REFUSED: OUTPUT_DIR '$OUTPUT_DIR' must contain 'seed${SEED}'."; exit 2; }
mkdir -p "$OUTPUT_DIR"

echo "Sign-only GRPO | SEED=$SEED | MAX_STEPS=$MAX_STEPS | OUTPUT_DIR=$OUTPUT_DIR | resume=$RESUME_FROM_CHECKPOINT"
echo "Start: $(date)"

python train/grpo_train.py \
    --config train/configs/qwen25_7b_qwen_delta_sign.yaml \
    --mode train \
    --data_file data/remaining_goods.json \
    --output_dir "$OUTPUT_DIR" \
    --seed "$SEED" \
    --max_steps "$MAX_STEPS" \
    --save_steps 2000 \
    --eval_steps 2000 \
    --eval_data_file data/trial_goods.json \
    --reward_weighting sign_only \
    --resume_from_checkpoint "$RESUME_FROM_CHECKPOINT" \
    2>&1 | tee -a "logs/train_qd_sign_seed${SEED}_run.log"

echo "=== Sign-only GRPO complete (SEED=$SEED) ==="
echo "End: $(date)"
