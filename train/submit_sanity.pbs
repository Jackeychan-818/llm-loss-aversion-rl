#!/bin/bash
# ============================================================
# PBS Job Script — Sanity check on trial_goods.json (gdev queue)
# Quick test: ~100 steps, verify reward fires, loss moves
# ============================================================
#PBS -N lz-sanity
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=80gb
#PBS -l walltime=01:30:00
#PBS -o /home/users/jackeyc0/scratch/lambda-zero/logs/sanity_${PBS_JOBID}.out
#PBS -e /home/users/jackeyc0/scratch/lambda-zero/logs/sanity_${PBS_JOBID}.err
#PBS -j oe
#PBS -P personal-jackeyc0

# ---------- Environment ----------
cd $PBS_O_WORKDIR
module purge
module load pytorch/2.6.0-py3-cu11.8

PROJECT_DIR="$HOME/scratch/lambda-zero"
source "$PROJECT_DIR/venv/bin/activate"

# vLLM's compiled extension needs libcudart.so.13, which torch's own
# nvidia-cuda-runtime pip package bundles but doesn't put on the default
# linker search path. Without this, "import vllm._C" fails.
export LD_LIBRARY_PATH="$(ls -d "$PROJECT_DIR"/venv/lib/python3.*/site-packages/nvidia/cu13/lib):$LD_LIBRARY_PATH"

# ---------- Verify GPU ----------
echo "=== GPU Check ==="
nvidia-smi
python -c "import torch; print(f'CUDA devices: {torch.cuda.device_count()}, Device: {torch.cuda.get_device_name(0)}')"

# ---------- Run sanity check ----------
echo "=== Starting sanity check ==="
cd "$PROJECT_DIR"

python train/grpo_train.py \
    --config train/configs/qwen25_7b.yaml \
    --mode sanity \
    --max_steps 100 \
    --data_file data/trial_goods.json \
    --output_dir checkpoints/sanity_$(date +%Y%m%d_%H%M) \
    2>&1 | tee logs/sanity_run.log

echo "=== Sanity check complete ==="
